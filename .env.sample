# PLCVM — environment variables
# Copy to `.env` and fill in values. `.env` is gitignored — NEVER commit it.
#
# ---------------------------------------------------------------------------
# How these two kinds of variable are read
# ---------------------------------------------------------------------------
#   APP_VARIANT      Read at BUILD time by app.config.ts, in Node. It is NOT
#                    part of the app manifest and is NOT inlined into the
#                    bundle. The absence of the EXPO_PUBLIC_ prefix is
#                    deliberate: that prefix is what tells Metro to substitute
#                    a value into the JavaScript at bundle time.
#
#   EXPO_PUBLIC_*    Inlined into the JS bundle by Metro and read at RUNTIME.
#                    Values must be referenced as static
#                    `process.env.EXPO_PUBLIC_FOO` dot-notation for Metro to
#                    see them; dynamic/bracket access is not inlined.

# --- Build variant ---------------------------------------------------------
# [CONFIG] development | preview | production
#
# Local development: set this to `development` (or leave unset — `development`
# is the fallback when the variable is absent).
#
# EAS builds: DO NOT rely on this file. `.env` is gitignored, so it does not
# exist on the build server. Each EAS build profile sets its own value in
# `eas.json` under `build.<profile>.env.APP_VARIANT`. The `production` profile
# MUST set it, or the build fails with an explicit error instead of silently
# producing a development-flagged build.
APP_VARIANT=development

# --- API base URL ----------------------------------------------------------
# [CONFIG] Required. The value is a public URL, safe to log the key name.
# There is NO localhost fallback: `API_BASE_URL` is read as
# `process.env.EXPO_PUBLIC_API_URL as string`, so leaving it unset yields
# `undefined` and axios requests fail against a relative base.
EXPO_PUBLIC_API_URL=https://your-api.example.com/api/cpps/PensionersApp/v1

# --- Client-side Fernet key ------------------------------------------------
# [SECRET] Never log the value.
# [SECURITY] Ships INSIDE the app bundle — it is obfuscation, not real
# encryption, because anyone with the APK can extract it. Used by
# `@lib` (encryptText / decryptText / sha256). Required: `decryptText`
# throws `Fernet key missing` when it is unset.
EXPO_PUBLIC_FERNET_KEY=

# --- DEV-ONLY automation credentials ---------------------------------------
# [DEV-ONLY] EXPO_PUBLIC_* values are compiled into the JS bundle. NEVER set
# these in the EAS production profile; doing so ships working credentials to
# every user. Read by the login form, change-password screen and the
# registration form purely to prefill fields in development.
EXPO_PUBLIC_PPO_NO=
EXPO_PUBLIC_PASSWORD=

# --- DEV-ONLY registration prefill -----------------------------------------
# [DEV-ONLY] Bank account number and date of birth prefilled into the
# registration form during local development only.
EXPO_PUBLIC_AC_NO=
EXPO_PUBLIC_DOB=

# --- Not yours to set ------------------------------------------------------
# NODE_ENV is set by Expo/Metro, not here. It is read by `@utils`' logger
# and by the error boundaries in `@components/providers/errors`.

# --- REST Client (.http) dev tokens ----------------------------------------
# [DEV-ONLY] Populated from a fresh login; never commit real values.
# ACCESS_TOKEN=
# RENEW_TOKEN=
# PPO_NO=
# PASSWORD=
